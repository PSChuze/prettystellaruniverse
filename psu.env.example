# Settings for the PSU server (compose.yml). PSU Server Setup copies this file to .env and fills it
# in; by hand: cp psu.env.example .env, set PSU_GAME_ADDR and PSU_PANEL_TOKEN, then
# docker compose up -d. After a change run docker compose up -d again (a plain `docker restart`
# does not re-read this file).

# This machine's IPv4 address as the players reach it: the address on your home network when
# everyone plays at home (e.g. 10.0.0.20), your internet address when friends play over the
# internet. The login service hands it to every client, so it has to be an address, not a name.
PSU_GAME_ADDR=

# The DNS server for consoles is shared by every OpenLobby install on this machine. Setup starts
# this folder's (COMPOSE_PROFILES=dns) only when none runs yet, and adds the game's four names to
# whichever one runs. PSU_DNS_ANSWER: the address it answers them with (default: PSU_GAME_ADDR).
# PSU_DNS_BIND: the address it listens on (default: all; on Linux with systemd-resolved, set this
# machine's network address, because 127.0.0.53:53 is taken). PSU_DNS_CLIENTS: who may ask, as
# CIDRs (default: loopback and the private ranges; it forwards other names, so never open it to
# the internet).
PSU_DNS_ANSWER=
PSU_DNS_BIND=
PSU_DNS_CLIENTS=

# Optional parts of compose.yml, comma-separated:
#   dns           the DNS server for consoles (UDP 53), when no other install runs one
#   experimental  the Xbox 360 patch leg and the Ambition of the Illuminus PC client (untested)
COMPOSE_PROFILES=dns

# The login service's own ports (inside Docker). With the experimental profile add the PC login:
# 22110,22140,22230.
PSU_LOGIN_PORTS=22110,22140

# The login notice while state/news.txt has none (the box fits about 50 characters a line).
PSU_MOTD=Welcome to the Phantasy Star Universe server.

# The universes on the Uni-cube (Server Select): "id:name,...".
PSU_UNIVERSES=1:Universe 1,2:Universe 2,3:Universe 3

# Game masters: login user IDs, comma-separated. They can use the ! commands in chat.
PSU_ADMINS=

# 1: a new user ID makes an account on its first login, with the password typed. 0: only accounts
# that exist already can log in.
PSU_AUTOREGISTER=1

# Wrong passwords in a row before a user ID is locked for 10 minutes.
PSU_LOGIN_FAIL_LIMIT=8

# Seconds a connection may stay silent before it is closed.
PSU_IDLE_SECS=600

# Seasonal lobbies (server/psu/season.py): none, auto (by the calendar) or a season name. They need
# the season archives extract builds. Event items drop 1 in PSU_SEASON_DROP (0: off).
PSU_SEASON=none
PSU_SEASON_DROP=40

# Extra archives over the lobby ones, a folder inside /nbl (e.g. /nbl/aoti-staging). Empty: off.
PSU_NBL_EXTRA=

# The token an OpenLobby admin panel sends to the game's admin port (http://psu:22191 on the
# openlobby Docker network; never published). Setup makes one at random. Empty: the port stays off.
PSU_PANEL_TOKEN=

# The pairing secret a panel gave setup (Pair with an OpenLobby admin panel). Setup uses it to tell
# the panel about a new token.
OPENLOBBY_PAIRING=

# The containers the panel's server check covers. Setup sets them for its project name.
PSU_PANEL_CONTAINERS=psu-game-1,psu-login-1,psu-patch-1,psu-ssl3-psu-1,psu-ssl3-aoti-1

# Where the game data, the accounts and the logs live (relative to this folder, or absolute).
PSU_DATA=./data
PSU_STATE=./state
PSU_LOGS=./logs

# The user the server runs as. On Linux, the owner of the folders above (setup sets your own);
# Docker Desktop does not care.
PSU_UID=10110
PSU_GID=10110

# The tag of the SSLv3 terminator image (ghcr.io/prettyopenlobby/openlobby-ssl3).
OPENLOBBY_TAG=latest

# Set by setup when it builds the server: the commit of this folder's files and when it was built
# (the panel shows them under Updates).
PSU_BUILD_COMMIT=
PSU_BUILT_AT=

# The certificate name of the experimental PC login.
PSU_PC_SSL3_CN=PSUServer

# The observe profile's greeting: hex bytes sent on connect. Empty: none.
PSU_OBSERVE_GREETING=
